{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",

    "moduleResolution": "node",
    "jsx": "react",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,

    // Vite (esbuild) does the transpiling; tsc is typecheck-only. This
    // prevents compiled .js/.d.ts artifacts from being emitted into src/,
    // which previously shadowed the .tsx sources in the dev server.
    "noEmit": true
  },
  "exclude": ["dist"]
}
